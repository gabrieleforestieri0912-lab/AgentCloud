{
  "manifest_version": 3,
  "name": "AgentCloud Copilot",
  "version": "0.2.0",
  "description": "Porta gli agenti AI autonomi di AgentCloud su Chrome, Edge, Brave, Opera e Firefox.",
  "author": "support@agentcloud.agency",
  "homepage_url": "https://agentcloud.agency",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://agentcloud.agency/*",
    "https://www.agentcloud.agency/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AgentCloud Copilot"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copilot@agentcloud.agency",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
