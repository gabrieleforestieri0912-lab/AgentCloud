{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-list*": "allow",
      "git stash list*": "allow",
      "git ls-files*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "npm run typecheck*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push origin --delete*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- .": "deny",
      "git clean -*": "deny"
    }
  }
}