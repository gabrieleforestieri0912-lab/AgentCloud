{
  "name": "agentcloud-cli",
  "version": "0.7.0",
  "description": "AgentCloud CLI — gestisci agenti AI autonomi dal terminale (login via browser, stesso DB web/mobile)",
  "main": "dist/index.js",
  "bin": {
    "agentcloud": "dist/index.js",
    "ac": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node dist/index.js --help"
  },
  "keywords": [
    "agentcloud",
    "ai",
    "agents",
    "cli",
    "automation",
    "supabase"
  ],
  "author": "AgentCloud Team <support@agentcloud.agency>",
  "license": "MIT",
  "homepage": "https://agentcloud.agency",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrieleforestieri0912-lab/AgentCloud.git",
    "directory": "cli"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "diff": "^8.0.4",
    "ink": "^6.8.0",
    "open": "^10.1.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.4.0"
  }
}
