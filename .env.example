# AgentCloud — esempio variabili d'ambiente (SOLO nomi, nessun valore reale).
# Copia in .env.local e compila con i valori del Partner Dashboard / Vercel.
#
# Le chiavi OAuth dei provider si creano sulle rispettive console. Il redirect URI
# da registrare è sempre https://<dominio>/api/integrations/<provider>/callback
# (vedi docs/integrations.md per il passo per passo di ogni provider).

# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,read_customers,write_customers,read_content,write_content
SHOPIFY_WEBHOOK_ADDRESS=
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_AGENT_SLUG=

# --- Google (Gmail, Calendar, Sheets, Drive) ---
# Un solo OAuth client per tutti e quattro i provider Google. Ogni provider ha
# però il proprio redirect URI, da aggiungere agli Authorized redirect URI:
#   .../api/auth/google/callback            (Gmail, Calendar)
#   .../api/integrations/google_sheets/callback
#   .../api/integrations/google_drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SCOPES=
# Scope Drive: opzionali, hanno il default documentato in integrations/catalog.ts
GOOGLE_DRIVE_SCOPES=
GOOGLE_SHEETS_SCOPES=

# --- Airtable ---
# airtable.com/develop → OAuth2 integration. PKCE obbligatorio nel codice.
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_SCOPES=

# --- Trello ---
# power-ups/admin → il.key. Trello non ha client secret per /1/authorize, ma
# TRELLO_API_SECRET serve per la revoca del token.
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_SCOPES=
# never | 30days | <N>days. Default 30days: con never il token non scade mai e
# nessuno può revocarlo da solo.
TRELLO_TOKEN_EXPIRATION=

# --- WooCommerce ---
# NON esistono chiavi per-store in env: Consumer Key e Secret nascono sullo store
# del cliente e sono cifrate in Supabase (tenant_integrations), per tenant.
# Qui serve solo il nome che l'utente vede nella schermata di autorizzazione.
WOOCOMMERCE_APP_NAME=
WOOCOMMERCE_SCOPE=

# --- Mailchimp ---
# Account → Extra → OAuth2. "Client ID" e "Client Secret" nella schermata.
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=

# --- Microsoft 365 (Word, Excel, PowerPoint, OneNote via Graph) ---
# Entra ID → App registrations → la tua app → Certificates & secrets.
# Redirect URI da registrare (piattaforma "Web"):
#   .../api/integrations/microsoft/callback
# PKCE obbligatorio; permessi DELEGATI (mai app-only: OneNote non li supporta).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common | organizations | consumers | <dominio|GUID tenant>. Default: common
MS_TENANT_ID=
# Deve coincidere con il redirect registrato su Entra. Se assente si usa
# NEXT_PUBLIC_SITE_URL + /api/integrations/microsoft/callback.
MS_REDIRECT_URI=
# Override degli scope delegati (default: offline_access User.Read Files.ReadWrite Notes.ReadWrite)
MS_SCOPES=
# Opt-in SharePoint: 1 aggiunge Sites.ReadWrite.All (non è nel default).
MS_SHAREPOINT=

# --- Microsoft Outlook (email + calendario via Graph, provider `microsoft_outlook`) ---
# Stessa app Entra qui sopra (stesso client id/secret): redirect AGGIUNTIVO da
# registrare (piattaforma "Web"):
#   .../api/integrations/microsoft_outlook/callback
# Connessione separata da Microsoft 365: il consenso mail/calendario è
# incrementale (chi usa solo Word non vede permessi email). Scope gratuiti, mai
# metered (throttling Outlook: 10.000 richieste/10min per app+mailbox).
# Override degli scope delegati (default: offline_access User.Read Mail.Read
# Mail.ReadWrite Calendars.ReadWrite Mail.Send — Mail.Send serve a
# outlook_send_message, che richiede comunque approvazione esplicita in chat).
MS_OUTLOOK_SCOPES=

# --- Google Docs (provider `google_docs`, stesso OAuth client di Drive/Sheets) ---
# Redirect AGGIUNTIVO da registrare accanto agli altri redirect Google:
#   .../api/integrations/google_docs/callback
# Scope minimi: drive.file (NON-SENSITIVE, crea + opera sui file dell'app/scelti)
# + documents (contenuto dei documenti esistenti; non restricted, niente
# assessment a pagamento). Niente scope Drive completo (restricted).
# Override: GOOGLE_DOCS_SCOPES (default: drive.file + documents).
GOOGLE_DOCS_SCOPES=

# --- Google Forms (provider `google_forms`, stesso OAuth client di Drive/Sheets) ---
# Redirect AGGIUNTIVO da registrare accanto agli altri redirect Google:
#   .../api/integrations/google_forms/callback
# Scope minimi: forms.body + forms.responses.readonly (non restricted, niente
# assessment a pagamento) + drive.file (NON-SENSITIVE, file collegato al form).
# Niente Pub/Sub: polling incrementale on-demand (costo zero).
# Override: GOOGLE_FORMS_SCOPES (default: i tre scope sopra).
GOOGLE_FORMS_SCOPES=

# --- Google Analytics 4, sola lettura (provider `google_analytics`) ---
# Redirect AGGIUNTIVO da registrare accanto agli altri redirect Google:
#   .../api/integrations/google_analytics/callback
# Scope: analytics.readonly (non restricted, niente assessment a pagamento).
# Quote gratuite: 200.000 token/giorno per proprietà standard (Core),
# 40.000/ora; i report restano in cache 30 minuti per istanza.
# Override: GOOGLE_ANALYTICS_SCOPES (default: analytics.readonly).
GOOGLE_ANALYTICS_SCOPES=

# --- GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Altri provider generici già supportati ---
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_SCOPES=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# --- Sicurezza delle integrazioni ---
# Chiave con cui cifrare i token (AES-256-GCM) e firmare lo state OAuth.
# Se assente si fa fallback a TENANT_STORE_KEY. GENERA UNA STRINGA LUNGO
# E CASUALE: "openssl rand -hex 32"
INTEGRATIONS_TOKEN_ENCRYPTION_KEY=
INTEGRATIONS_STATE_SECRET=

# --- Chiavi server obbligatorie in produzione (fail-closed se assenti) ---
# Cifratura store tenant locale (niente default "dev-*" in prod).
TENANT_STORE_KEY=
# Firma webhook WhatsApp (Meta Dashboard → App → WhatsApp → Configuration).
# Senza, POST /api/whatsapp/webhook risponde 401.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Bearer per POST /api/email/webhook. Senza, l'endpoint risponde 401/404.
EMAIL_WEBHOOK_SECRET=
# Verifica firma PayPal. Senza, il webhook viene rifiutato (fail-closed).
PAYPAL_WEBHOOK_ID=
# Auth cron/notifiche SOLO via header Authorization (niente ?token=).
CRON_SECRET=
ADMIN_API_TOKEN=

# --- Base URL del sito ---
# Determina il redirect URI OAuth quando manca una variabile per provider.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_URL=