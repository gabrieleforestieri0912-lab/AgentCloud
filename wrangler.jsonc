{
  // Configurazione Wrangler per il deploy su Cloudflare Workers
  // (output OpenNext di Next.js: worker + assets statici).
  "name": "agentcloud",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
